import numpy as np
import matplotlib.pyplot as plt

def strong_base_strong_acid_titration(C_base, V_base, C_acid, V_acid_max=0.05, points=500):
    """
    Generate titration curve for strong base vs strong acid.
    
    Parameters:
    C_base : float - concentration of strong base (mol/L)
    V_base : float - volume of strong base (L)
    C_acid : float - concentration of strong acid (mol/L)
    V_acid_max : float - max volume of acid added (L)
    points : int - number of points in curve
    """
    n_base = C_base * V_base  # total moles of base
    V_acid = np.linspace(0, V_acid_max, points)
    pH_values = []

    for Va in V_acid:
        n_acid = C_acid * Va
        total_volume = V_base + Va
        
        if n_acid < n_base:  # Before equivalence (base in excess)
            OH_conc = (n_base - n_acid) / total_volume
            pOH = -np.log10(OH_conc)
            pH = 14 - pOH
        elif np.isclose(n_acid, n_base):  # At equivalence
            pH = 7.0
        else:  # After equivalence (acid in excess)
            H_conc = (n_acid - n_base) / total_volume
            pH = -np.log10(H_conc)
        
        pH_values.append(pH)
    
    # Plot
    plt.figure(figsize=(8,6))
    plt.plot(V_acid*1000, pH_values, label="Titration Curve")
    
    V_eq = (n_base/C_acid)*1000  # equivalence point volume in mL
    plt.axvline(V_eq, color='g', linestyle='--', label="Equivalence Point")
    
    plt.xlabel("Volume of HCl added (mL)")
    plt.ylabel("pH")
    plt.title("Strong Base vs Strong Acid Titration Curve")
    plt.legend()
    plt.grid(True)
    plt.show()

# Example: NaOH (0.1 M, 25 mL) titrated with HCl (0.1 M)
strong_base_strong_acid_titration(C_base=0.1, V_base=0.025, C_acid=0.1, V_acid_max=0.05)
